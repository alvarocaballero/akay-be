<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="github" value="https://nuget.pkg.github.com/alvarocaballero/index.json" />
  </packageSources>

  <packageSourceCredentials>
    <github>
      <add key="Username" value="%GITHUB_PACKAGES_USERNAME%" />
      <add key="ClearTextPassword" value="%GITHUB_PACKAGES_TOKEN%" />
    </github>
  </packageSourceCredentials>

  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="coverlet.collector" />
      <package pattern="FluentValidation" />
      <package pattern="Microsoft.Extensions.AI.OpenAI" />
      <package pattern="Microsoft.NET.Test.Sdk" />
      <package pattern="Microsoft.CodeCoverage" />
      <package pattern="Microsoft.TestPlatform.TestHost" />
      <package pattern="Mono.Cecil" />
      <package pattern="Microsoft.Extensions.Diagnostics.HealthChecks" />
      <package pattern="NetArchTest.Rules" />
      <package pattern="SonarAnalyzer.CSharp" />
      <package pattern="xunit" />
      <package pattern="xunit.analyzers" />
      <package pattern="xunit.assert" />
      <package pattern="xunit.core" />
      <package pattern="xunit.runner.visualstudio" />
      <package pattern="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" />
      <package pattern="Azure.Data.AppConfiguration" />
      <package pattern="Azure.Identity" />
      <package pattern="Azure.Messaging.EventGrid" />
      <package pattern="Azure.Messaging.EventGrid.SystemEvents" />
      <package pattern="Azure.Security.KeyVault.Secrets" />
      <package pattern="DnsClient" />
      <package pattern="Microsoft.Bcl.HashCode" />
      <package pattern="Microsoft.Extensions.Azure" />
      <package pattern="Microsoft.Extensions.Configuration.AzureAppConfiguration" />
      <package pattern="Microsoft.Identity.Client" />
      <package pattern="Microsoft.Identity.Client.Extensions.Msal" />
      <package pattern="Microsoft.IdentityModel.Abstractions" />
      <package pattern="System.Security.Cryptography.ProtectedData" />
      <package pattern="Microsoft.Extensions.DependencyInjection" />
      <package pattern="Microsoft.Extensions.DependencyInjection.Abstractions" />
      <package pattern="Azure.Core" />
      <package pattern="Azure.Monitor.OpenTelemetry.Exporter" />
      <package pattern="Microsoft.ApplicationInsights" />
      <package pattern="Microsoft.ApplicationInsights.AspNetCore" />
      <package pattern="Microsoft.AspNetCore.HeaderPropagation" />
      <package pattern="Microsoft.Bcl.AsyncInterfaces" />
      <package pattern="Microsoft.Extensions.Configuration" />
      <package pattern="Microsoft.Extensions.Configuration.Abstractions" />
      <package pattern="Microsoft.Extensions.Configuration.Binder" />
      <package pattern="Microsoft.Extensions.Diagnostics" />
      <package pattern="Microsoft.Extensions.Diagnostics.Abstractions" />
      <package pattern="Microsoft.Extensions.FileProviders.Abstractions" />
      <package pattern="Microsoft.Extensions.Hosting.Abstractions" />
      <package pattern="Microsoft.Extensions.Http" />
      <package pattern="Microsoft.Extensions.Logging" />
      <package pattern="Microsoft.Extensions.Logging.Abstractions" />
      <package pattern="Microsoft.Extensions.Logging.Configuration" />
      <package pattern="Microsoft.Extensions.Options" />
      <package pattern="Microsoft.Extensions.Options.ConfigurationExtensions" />
      <package pattern="Microsoft.Extensions.Primitives" />
      <package pattern="OpenTelemetry" />
      <package pattern="OpenTelemetry.Api" />
      <package pattern="OpenTelemetry.Api.ProviderBuilderExtensions" />
      <package pattern="OpenTelemetry.Extensions.Hosting" />
      <package pattern="OpenTelemetry.Instrumentation.AspNetCore" />
      <package pattern="OpenTelemetry.Instrumentation.Http" />
      <package pattern="OpenTelemetry.Instrumentation.SqlClient" />
      <package pattern="OpenTelemetry.PersistentStorage.Abstractions" />
      <package pattern="OpenTelemetry.PersistentStorage.FileSystem" />
      <package pattern="System.ClientModel" />
      <package pattern="System.Memory.Data" />
    </packageSource>
    <packageSource key="github">
      <package pattern="Akay.To.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>

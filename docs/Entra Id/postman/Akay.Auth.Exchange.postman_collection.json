{
  "info": {
    "_postman_id": "akay-auth-exchange-local",
    "name": "Akay - Entra ID to Akay JWT Exchange",
    "description": "Collection to test the /api/auth/exchange flow. It obtains a Microsoft Entra External ID (CIAM) access token via OAuth 2.0 Authorization Code with PKCE, exchanges it for an Akay JWT, and stores the token in the `token` environment variable for subsequent requests.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1a. Exchange Entra token (password flow)",
      "request": {
        "auth": {
          "type": "oauth2",
          "oauth2": {
            "grant_type": "authorization_code_with_pkce",
            "authUrl": "https://{{entraTenantName}}.ciamlogin.com/{{entraTenantId}}/oauth2/v2.0/authorize",
            "accessTokenUrl": "https://{{entraTenantName}}.ciamlogin.com/{{entraTenantId}}/oauth2/v2.0/token",
            "clientId": "{{entraClientId}}",
            "scope": "openid profile email api://{{entraApiClientId}}/access_as_user",
            "redirect_uri": "https://oauth.pstmn.io/v1/callback",
            "code_challenge_method": "S256",
            "state": "{{$randomUUID}}",
            "client_authentication": "body",
            "tokenName": "entraToken"
          }
        },
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/auth/exchange",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "exchange"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.response.code !== 200) {",
              "    console.error('Exchange failed. Status:', pm.response.code);",
              "    console.error('Response:', pm.response.text());",
              "    return;",
              "}",
              "",
              "const json = pm.response.json();",
              "pm.environment.set('token', json.accessToken);",
              "console.log('Akay token stored in token environment variable.');",
              "console.log('Expires in:', json.expiresIn);"
            ],
            "type": "text/javascript",
            "packages": {}
          }
        }
      ]
    },
    {
      "name": "2. Example - Call protected Akay endpoint",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": {
            "token": "{{token}}"
          }
        },
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/users",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "users"
          ]
        }
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5246",
      "type": "string"
    },
    {
      "key": "entraTenantName",
      "value": "{tenant-login}",
      "type": "string"
    },
    {
      "key": "entraTenantId",
      "value": "{tenant-id}",
      "type": "string"
    },
    {
      "key": "entraClientId",
      "value": "{postman-client-id}",
      "type": "string"
    },
    {
      "key": "entraApiClientId",
      "value": "{api-client-id}",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    }
  ]
}

{
  "CorrelationHeader": "X-Correlation-Id",
  "CultureInfo": "es-ES;en-EN",
  "Application": {
    "Name": "Akay.Be",
    "Description": "API para Akay",
    "Url": "https://akay.api.com"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning"
      }
    }
  },
  "SecuritySettings": {
    "AuthenticationType": "BearerOrApiKey",
    "Jwt": {
      "Audience": "akay",
      "Issuer": "akay.bff",
      "Key": "[En secrets o KV]"
    },
    "ApiKey": {
      "Header": "X-Api-Key",
      "Key": "[En secrets o KV]",
      "KeyClients": "[En secrets o KV]"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=.;Database=AkayDb;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "DbContextSettings": {
    "ApplicationDbContext": {
      "ConnectionStringName": "DefaultConnection",
      "CommandTimeoutSeconds": 30,
      "QuerySplittingBehavior": "SplitQuery",
      "EnableDetailedErrors": true,
      "Resilience": {
        "Enabled": true,
        "MaxRetryCount": 5,
        "MaxRetryDelaySeconds": 10
      },
      "Interceptors": {
        "Outbox": true, // son true por defecto
        "ChangeTrackingAudit": true
      },
      "ChangeTrackingSettings": {
        "TableName": "__ChangeAudit",
        "Schema": "infra",
        "IgnoredProperties": [ "RowVersion" ]
      },
      "OutboxMessageSettings": {
        "TableName": "__OutboxMessages",
        "Schema": "infra"
      }
    }
  },
  "MessagingSettings": {
    "Transport": "AzureServiceBus", // O "InMemory" o "RabbitMq"
    "ConnectionString": "[En secrets o KV]",
    "InputQueueName": "akaybe.api",
    "MaxDeliveryAttempts": 3
  },
  "AzureStorageSettings": {
    "UseAzureSignalR": true,
    "ConnectionString": "[En secrets o KV]"
  },
  "AzureSignalRSettings": {
    "ConnectionString": "[En secrets o KV]"
  },
  "SpeechSettings": {
    "Key": "[En secrets o KV]",
    "Region": "westeurope",
    "Language": "es-ES",
    "VoiceName": "es-ES-AlvaroNeural",
    "OutputFormat": "Audio16Khz32KBitRateMonoMp3"
  },
  "TranslatorSettings": {
    "Key": "[En secrets o KV]",
    "BaseUrl": "https://api.cognitive.microsofttranslator.com",
    "Region": "westeurope",
    "DefaultLanguage": "es-ES"
  },
  "RateLimitingSettings": [
    {
      "Name": "per-user",
      "Type": "PerUser",
      "PermitLimit": 100,
      "IntervalSeconds": 60,
      "QueueLimit": 0
    },
    {
      "Name": "per-endpoint",
      "Type": "PerEndpoint",
      "PermitLimit": 200,
      "IntervalSeconds": 20,
      "QueueLimit": 0
    },
    {
      "Name": "health-endpoint",
      "Type": "PerPartitionKey",
      "PartitionKey": "health",
      "PermitLimit": 1,
      "IntervalSeconds": 30,
      "QueueLimit": 0
    }
  ],
  "HttpClientSettings": [
    {
      "Name": "JsonPlaceholder",
      "BaseUrl": "https://jsonplaceholder.typicode.com/",
      "Timeout": "55"
    }
  ]

}
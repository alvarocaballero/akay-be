{
  "AllowedHosts": "*",
  "CorrelationHeader": "X-Correlation-Id",
  "CultureInfo": "es-ES;en-EN",
  "Application": {
    "Name": "Akay.Be",
    "Description": "API para Akay",
    "Url": "https://akay.api.com"
  },
  "Security": {
    "AuthenticationType": "BearerOrApiKey",
    "HeaderApiKey": "X-Api-Key",
    "Jwt": {
      "Audience": "akay",
      "Issuer": "akay.bff",
      "Key": "[En secrets o KV]"
    },
    "ApiKey": {
      "Header": "X-Api-Key",
      "Key": "[En secrets o KV]",
      "KeyClients": "[{\"clientId\":1,\"clientName\":\"Client 1\",\"apiKey\":\"[En secrets o KV]\",\"roles\":[\"admin\"]},{\"clientId\":2,\"clientName\":\"Client 2\",\"apiKey\":\"[En secrets o KV]\",\"roles\":[\"reader\", \"writer\"]}]"
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
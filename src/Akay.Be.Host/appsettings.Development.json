{
  // El null es para que funcione SignalRTest ejecutando el index.html desde el navegador. NO EN PRODUCCIÓN
  "CorsAllowedOrigins": "http://localhost:3000;http://localhost:5246;null",

  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft.AspNetCore": "Information",
        "System": "Information"
      }
    }
  },
  "AzureStorageSettings": {
    "ConnectionString": "UseDevelopmentStorage=true"
  },
  "MessagingSettings": {
    "ConnectionString": "Endpoint=sb://localhost;SharedAccessKeyName=RootManageSharedAccessKey;SharedAccessKey=SAS_KEY_VALUE;UseDevelopmentEmulator=true;",
    "InputQueueName": "akaybe.api",
    "MaxDeliveryAttempts": 3
  },
  "AzureSignalRSettings": {
    "UseAzureSignalR": false
  }
}
